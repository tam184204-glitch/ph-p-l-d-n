# Cấu hình Module Pháp lý dự án — không đưa file này lên git
PORT=3400
# 127.0.0.1 = chỉ máy này. Đặt 0.0.0.0 để cả phòng truy cập qua mạng LAN.
HOST=127.0.0.1
DATABASE_URL=postgres://qlda_app:MAT_KHAU@localhost:5432/ctg_qlda
# DB QLDA nguồn (dự án, gói thầu, hợp đồng, nhà thầu, người dùng, mốc tiến độ, hồ sơ, cảnh báo) — chỉ đọc
QLDA_URL=postgres://duan_owner:MAT_KHAU@localhost:5432/duan_noxh_ct
# AI (Claude): đọc tệp hồ sơ, kiểm tra sai sót / mâu thuẫn, đối chiếu kết quả scan, soạn và kiểm tra dự thảo, bổ sung checklist.
# Để trống = tắt AI; checklist, kế hoạch, xuất bộ hồ sơ, văn bản từng hộ vẫn dùng bình thường.
ANTHROPIC_API_KEY=
# In PDF bằng Microsoft Edge chạy ẩn (tự tìm). Máy không có Edge: trỏ tới chrome.exe
EDGE_PATH=
# Gemini (Google AI Studio): Trợ lý AI — để trống = chỉ dùng Claude
GEMINI_API_KEY=
# 1 = bỏ đăng nhập khi chạy thử (tự vào bằng tài khoản admin). Không bật khi HOST=0.0.0.0
# NO_LOGIN=1
